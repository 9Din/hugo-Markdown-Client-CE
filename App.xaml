<Application x:Class="Huge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 亮色主题 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#C56473"/>
        <SolidColorBrush x:Key="BgBrush" Color="#FEFEFB"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F0EFEB"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E1DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#24231F"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#787670"/>
        <SolidColorBrush x:Key="EditorBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TreeBgBrush" Color="Transparent"/>

        <!-- 暗色主题 -->
        <SolidColorBrush x:Key="DarkBgBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DarkPanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="DarkTextBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="DarkMutedTextBrush" Color="#9D9D9D"/>
        <SolidColorBrush x:Key="DarkEditorBgBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DarkTreeBgBrush" Color="#252526"/>
        <SolidColorBrush x:Key="DarkButtonHoverBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="DarkAccentBrush" Color="#E8828E"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小型格式化按钮样式 -->
        <Style x:Key="FormatBtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource EditorBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource TreeBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- 主题化 ScrollViewer：修复滚动条交叉处角落白块（角填充为 PanelBrush） -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Focusable="False"
                                       IsTabStop="False"
                                       KeyboardNavigation.TabNavigation="None"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Focusable="False"
                                       IsTabStop="False"
                                       KeyboardNavigation.TabNavigation="None"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <!-- 横竖滚动条交叉的角：用面板色填充，避免出现默认白色块 -->
                            <Rectangle Grid.Row="1" Grid.Column="1"
                                       Fill="{DynamicResource PanelBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题化滚动条：采用 WPF 官方 Aero 模板结构（单个 PART_Track，Trigger 切换布局方向），保证 Thumb 可拖拽且滑块联动 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <ControlTemplate.Resources>
                            <ControlTemplate x:Key="RepeatBtnTemplate" TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </ControlTemplate.Resources>
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Focusable="false"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Template="{StaticResource RepeatBtnTemplate}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Template="{StaticResource RepeatBtnTemplate}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Margin="1,0,1,0"
                                           Focusable="False"
                                           IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource BorderBrush}"
                                                        CornerRadius="5"
                                                        Margin="1,2,1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="14"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="14"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>